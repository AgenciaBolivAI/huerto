# Proyecto Supabase: rizoma-del-sur (adfudckqftijdpxpamwk)
# Copia este archivo a .env.local y rellena la clave de servicio.

NEXT_PUBLIC_SUPABASE_URL=https://adfudckqftijdpxpamwk.supabase.co

# Clave SECRETA de servicio. Dashboard → Project Settings → API Keys → service_role
#
# Se usa SOLO en el servidor (Server Components y Server Actions) y nunca llega
# al navegador. Es la que permite escribir con RLS activo: las tablas curso_*
# tienen RLS habilitado y sin políticas, de forma que la clave anónima —que es
# pública, va en el bundle de rizomadelsur.com— no puede tocar el progreso del
# curso ni aunque alguien la extraiga.
#
# No la commitees nunca. En Vercel se configura en Settings → Environment Variables.
SUPABASE_SERVICE_ROLE_KEY=
